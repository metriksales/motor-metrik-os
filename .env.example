# Metrik-OS — variáveis de ambiente (NUNCA commitar valores reais)
#
# Estes são os segredos DA PLATAFORMA (da Metrik). As credenciais DE CADA CONTA
# (token do CRM, instância de WhatsApp, chave de IA do cliente) não moram aqui:
# vão criptografadas no banco, pelo cofre — ver PRODUTO.md §7 e a story S-025.
#
# ⚠️ NUNCA use o prefixo VITE_ para segredo: tudo com esse prefixo é embutido no
# JavaScript que vai para o navegador.

# Banco (Neon Postgres, pooled) — também guarda estado, filas e travas
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/db?sslmode=require

# Autenticação própria (S-045)
SESSION_SECRET=troque-isto-por-um-segredo-forte
VAULT_MASTER_KEY=troque-isto-por-uma-chave-de-32-bytes-em-base64

# E-mail transacional (Resend) — código de entrada, convite, verificação
# A chave (permissão só de envio) existe SÓ no ambiente Production do Vercel.
# Em dev e preview, deixe vazio: a porta de e-mail entra em modo seco e escreve
# o código no console/Logs em vez de enviar. Para testar envio real sem tocar em
# caixa de verdade, use os endereços delivered@resend.dev e bounced@resend.dev.
RESEND_API_KEY=
EMAIL_FROM="Metrik-OS <nao-responda@seu-dominio>"

# Control API — token de máquina temporário (substituído por token por conta, S-003)
CONTROL_PLANE_SECRET=troque-isto-por-um-segredo-forte

# Entrada de mensagens — obrigatório; sem ele o webhook responde 503 (S-004)
WEBHOOK_SECRET=

# Cron do Vercel (varredura de filas e follow-up)
CRON_SECRET=

# IA — só para desenvolvimento/dogfood. Em produção a chave é de cada conta, no cofre.
OPENAI_API_KEY=

# Piloto leitor de grupos internos (somente observação; nunca responder)
GROUP_READER_WEBHOOK_SECRET=
GROUP_READER_HASH_SALT=
GROUP_READER_ALLOWLIST=120000000000000000@g.us

# Fora da stack por decisão (PRODUTO.md §11): Clerk (auth própria, S-045),
# Upstash Redis e QStash (estado e filas no Postgres, cron do Vercel).
