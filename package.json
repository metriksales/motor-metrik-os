{
  "name": "metrik-os",
  "private": true,
  "version": "0.1.0",
  "description": "Metrik-OS — bancada multi-tenant hospedada: agente construtor monta e mantém agentes de operação em CRM (GHL, Kommo) e WhatsApp. Monorepo: apps/web (front + API) + apps/runtime (motor) + packages.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @motor/web",
    "build:web": "npm run build --workspace @motor/web",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint .",
    "bundle": "npm run bundle --workspace @motor/web",
    "test": "npm run bundle && vitest run",
    "test:watch": "vitest",
    "ci": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
